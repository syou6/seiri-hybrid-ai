# Copy this file to ".env" and fill in your own Firebase project values.
# If these are left as placeholders, the app automatically runs in MOCK MODE
# (fully functional UI/flow with a local heuristic engine, no network calls).

# --- Firebase web app config (Firebase Console > Project settings > Your apps) ---
VITE_FIREBASE_API_KEY=YOUR_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:xxxxxxxxxxxxxxxxxxxxxx

# --- App Check (required by Firebase AI Logic) ---
# reCAPTCHA v3 site key from Firebase Console > App Check. Leave empty for local
# development; the app then registers an App Check debug token instead.
VITE_FIREBASE_APPCHECK_SITE_KEY=

# --- Cloud model used for deep structuring (Firebase AI Logic / Gemini) ---
VITE_CLOUD_MODEL=gemini-2.5-flash

# --- Force mock mode even when Firebase config is present ("true"/"false") ---
VITE_MOCK_MODE=false
